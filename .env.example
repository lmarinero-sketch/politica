# App Configuration
VITE_APP_TITLE="Vigía San Juan - Observatorio de Contrataciones y Transparencia Pública"
VITE_APP_ENV="development"
VITE_DEFAULT_CURRENCY="ARS"

# Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Service Role (Server-side only - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase Database (Direct Connection - for migrations/scripts)
DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# Supabase CLI / Management
SUPABASE_ACCESS_TOKEN="your-supabase-access-token"
SUPABASE_PROJECT_REF="your-project-ref"
SUPABASE_DB_PASSWORD="your-db-password"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Optional AI / Integration keys
OPENAI_API_KEY="your-openai-api-key"
